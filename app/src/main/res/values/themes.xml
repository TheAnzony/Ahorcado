<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Ahorcado" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:background">@color/bg</item>
    </style>

    <style name="Theme.Ahorcado" parent="Base.Theme.Ahorcado" />
    
    <style name="tv_letras">
        <item name="android:layout_margin">20dp</item>
        <item name="android:background">@color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">24sp</item>
        <item name="layout_constraintHeight_min">70dp</item>
    </style>
    
    <style name="tv_errores">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">24sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="tv_fallos">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">24sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="tv_intentos">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">20sp</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="botones">
        <item name="android:background">@color/bg_buttons</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>

